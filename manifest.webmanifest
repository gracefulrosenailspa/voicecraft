{
  "name": "VoiceCraft Studio",
  "short_name": "VoiceCraft",
  "description": "A browser-based narration and voice processing studio.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
